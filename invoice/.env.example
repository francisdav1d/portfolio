# Neon: use the pooled connection string for DATABASE_URL and the direct one for DIRECT_URL.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/invoice?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/invoice?sslmode=require"

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# The account that signs up with this email becomes the owner (you).
OWNER_EMAIL="you@example.com"

# Public URL of the app, used in email links.
APP_URL="http://localhost:3100"

# Resend. Leave RESEND_API_KEY empty in development: emails are saved to ./.emails as HTML instead.
RESEND_API_KEY=""
EMAIL_FROM="Your Name <invoices@yourdomain.com>"

# Protects /api/cron/reminders (Vercel Cron sends it as a Bearer token automatically).
CRON_SECRET=""

# Optional: require this code to sign up, so random people can't create accounts.
SIGNUP_CODE=""
